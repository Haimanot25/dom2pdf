{
  "name": "dom2pdf-benchmark",
  "version": "0.1.0-alpha.1",
  "description": "dom2pdf — deterministic HTML-to-PDF benchmark harness (dom2pdf, raw Playwright, html2pdf.js, WeasyPrint)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haimanot25/dom2pdf.git",
    "directory": "packages/benchmark"
  },
  "homepage": "https://github.com/Haimanot25/dom2pdf#readme",
  "bugs": {
    "url": "https://github.com/Haimanot25/dom2pdf/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "html2pdf.js": "0.14.0",
    "dom2pdf-js": "workspace:*",
    "playwright": "1.64.0"
  }
}
