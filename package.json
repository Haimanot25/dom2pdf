{
  "name": "pageforge-monorepo",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "PageForge — open-source HTML-to-PDF conversion engine (monorepo root)",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "pnpm --filter pageforge-pdf build && playwright test",
    "test": "pnpm test:unit && pnpm test:e2e",
    "browser:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
